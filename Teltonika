  <!-- CXPSFleet -->
  <div class="section">
    <div class="section-title">CXPSFleet · Desconexión (raw payload)</div>
    <div class="raw-block">
      <div class="raw-block-header">
        <span class="raw-block-title">Ejemplo de trama</span>
        <button class="copy-btn" data-cmd="prior=0, event_io_id=252, total_io=15, io_239=0, io_240=1, gsm=5, io_21=5, io_200=0, io_69=1, io_113=100, io_252=1, pdop=0.9, io_181=9, hdop=0.5, io_182=5, pwr_ext=10.852, io_66=10852, pwr_int=3.985, io_67=3985, io_68=0, io_9=0, mcc=712, mnc=3, io_241=71203, io_16=76671914">COPY</button>
      </div>
      prior=0, <strong>event_io_id=252</strong>, total_io=15, io_239=0, io_240=1, gsm=5, io_21=5, io_200=0, io_69=1, io_113=100, <strong>io_252=1</strong>, pdop=0.9, io_181=9, hdop=0.5, io_182=5, pwr_ext=10.852, io_66=10852, pwr_int=3.985, io_67=3985, io_68=0, io_9=0, mcc=712, mnc=3, io_241=71203, io_16=76671914
    </div>
  </div>
</div>

<div id="toast">✓ COPIADO</div>

<script>
  let lastBtn = null;

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.copy-btn[data-cmd]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const decoded = btn.dataset.cmd.replace(/&quot;/g, '"').replace(/&amp;/g, '&');

        navigator.clipboard.writeText(decoded).then(function() {
          if (lastBtn && lastBtn !== btn) {
            lastBtn.textContent = 'COPY';
            lastBtn.classList.remove('copied');
          }
          btn.textContent = '✓ OK';
          btn.classList.add('copied');
          lastBtn = btn;

          const toast = document.getElementById('toast');
          toast.classList.add('show');
          setTimeout(function() { toast.classList.remove('show'); }, 1800);
        }).catch(function(err) {
          alert('No se pudo copiar: ' + err);
        });
      });
    });
  });
</script>
</body>
</html>
